# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Hazard model build workspace
hazard_build/

# Built site and Privy bundle inputs
site/dist/
privy-bundle/node_modules/

# Local book and configuration
*.sqlite
clause.env

# Research working files: notes a session gathered and the report it wrote
# from them. The report is delivered to whoever asked for it; neither
# belongs in the product's history.
research_notes/
reports/

# Design explorations: direction pages, the screenshots taken of them, and the
# font files fetched to judge them by. They are how a look is decided, not part
# of the product, and a cancelled exploration is not something the history owes
# anybody. Whatever a direction settles becomes site/index.html, which is
# tracked; the sketches that got there stay on the machine they were drawn on.
design/

# Release packages
clause-*.tar.gz
clause-site-*.zip
RELEASE-*.md

# Local virtual environment
.venv/

# The accessibility engine, fetched from npm when the audit first runs.
.axe/

# A model file part way through being written. The build renames it into place.
clause/hazard/models/*.json.part
site/dev.html
site/desk.html
site/version.json
