# Copied to /etc/clause/clause.env, owned by root, mode 600.
#
# Every setting here defaults to the safe value when absent. The file exists to
# turn things on deliberately, not to make the service work.

# Browsers may call this API only from these origins. Never a wildcard: every
# write is a POST, so a wildcard would let any page on the internet act through
# a visitor's browser.
#
# Netlify serves the site at its own generated name as well as at the domain,
# and while DNS is still propagating that generated name is the only one that
# works. Add it here rather than reaching for a wildcard when the page says it
# cannot reach the protocol. Remove it once the domain is live.
CLAUSE_ORIGINS=https://clause.insure,https://www.clause.insure

# nginx sits in front, so the client address comes from the forwarded header.
# Without this the rate limiter would see every request as coming from nginx.
CLAUSE_BEHIND_PROXY=1

# The operator token. Set this on any deployment that will admit real
# companies, because without it there is no way to activate one and the reviewer
# screen on the site answers 404.
#
# It is what stands between a registration and a company being able to issue
# insurance to people, so treat it as the most valuable secret on this server:
# generate it here, keep it in a password manager, and never paste it into a
# chat, a screenshot or a terminal you did not open yourself.
#
# Generate it with:  openssl rand -hex 32
#
#   CLAUSE_OPERATOR_TOKEN=
#
# It is presented once, at "For insurers" on the site, and exchanged there for a
# session that expires in 45 minutes and does not survive a restart of this
# service. Nothing else on the site asks for it.

# The endpoints that drive the chain by hand: injecting a reading, silencing a
# source. They settle real policies, so they are off unless this is set, and
# even then they need the operator token on every call.
#
#   CLAUSE_DEMO=1
#
# The service refuses to start with CLAUSE_DEMO=1 and no token.

# Funds a freshly connected address so the interface can be operated without a
# faucet. This is free money: leave it off in public unless you are running a
# demonstration and know it is one.
#   CLAUSE_FAUCET=1

# Stand in companies: one carrier in every inhabited country and a reinsurer
# behind them, each named "Specimen ... (not a real company)", approved at
# start, so the protocol can be shown working anywhere without registering
# companies one by one. Every one of them is marked as not a real company
# wherever it is shown, but a page full of insurers that do not exist is
# still a page full of insurers that do not exist: set it to 1 only when you
# are running a demonstration and everybody looking knows it is one.
CLAUSE_SPECIMENS=0

# The schema page lists every route, including the ones that move money.
#   CLAUSE_PUBLIC_DOCS=1

# Trials behind every capital figure. Lower is faster and noisier. Twenty
# thousand is what the documented figures were computed at.
CLAUSE_TRIALS=12000

# ---------------------------------------------------------------------------
# Rider
# ---------------------------------------------------------------------------

# Set ONE of the two below. With neither, Rider is simply absent and the page
# says so rather than offering an assistant that cannot answer.

# The simple way: a model key, held on this server.
#   ANTHROPIC_API_KEY=sk-ant-...

# The better way: a Latch, and then no model key on this server at all. Latch is
# Rialo's own credential proxy (onlatch.com, also latch-beta.rialo.io). The key
# is stored there, this server holds only a scoped token, and every call passes
# a policy pipeline before the key is used: a daily spend cap metered per model,
# an endpoint allowlist, POST only, a rate limit.
#
# Create the latch with upstream https://api.anthropic.com and the key injected
# as an API key header named x-api-key. Rider then posts to
# <proxy>/proxy/v1/messages, and asks the latch for a decision before it spends,
# so a person is told "the daily budget is used up" rather than seeing a 403.
#
# If both are set, the latch wins and the key is unused.
#   CLAUSE_RIDER_LATCH=lat_...
#   CLAUSE_LATCH_PROXY=https://onlatch.com

# Flight delays outside the United States, on the home page. The FAA's feed
# is free and covers United States airports only. For the rest of the world
# set an AirLabs key (airlabs.co, a free plan gives 1,000 requests a month;
# the server reads the feed once an hour, which is about 720): every
# departure 45 minutes late or more, worldwide, grouped by airport. A
# FlightAware AeroAPI key is the alternative; it is a paid service and its
# plan has to allow showing the data publicly. With neither, the world view
# shows the FAA feed and other countries are told there is no feed.
#
#   CLAUSE_AIRLABS_KEY=
#   CLAUSE_AEROAPI_KEY=

# Rain, storm and drought settle on Open-Meteo's ERA5 archive, which is free
# and needs no key: leave this unset and everything works. The free tier is
# rate limited by address, though, so a server sharing an outbound address
# with anything else can spend the day's quota and then read nothing --
# which does not look like an error, it looks like a dry week. A commercial
# subscription (open-meteo.com/en/pricing) sends the same query to the
# customer host instead. Nothing about the key reaches a policy: what is
# written into a record is the free, public query anybody can repeat.
#
# Check it from the server with:  curl -s localhost:8080/api/health | jq .sources
#
#   CLAUSE_OPENMETEO_KEY=

# Signing in with email, Google, a passkey or a wallet, through Privy. Set the
# app id from the Privy dashboard (App settings, Basics, API keys). It is a
# public value; the Privy app secret is not needed and should not go here.
# Without it the site offers only the key made on the device.
#
#   CLAUSE_PRIVY_APP_ID=
#
# The server reads Privy's public keys from its JWKS address and needs outbound
# HTTPS to auth.privy.io for that. Where it has none, paste the ES256 key from
# "Verify with key instead" in the dashboard here, on one line with \n breaks.
#
#   CLAUSE_PRIVY_VERIFICATION_KEY=
#
# Linking an X account from the profile needs two switches in the Privy
# dashboard and nothing here: Login methods > Socials > X (Twitter) turned
# on with X's own client id and secret entered there, and Settings >
# Identity tokens turned on, which is how the server learns which X account
# Privy verified without holding the app secret.

# Payouts to a bank account or a mobile wallet. Without these the rail is
# manual: orders wait on the operator page with the full destination, someone
# makes the transfer, and marks the order paid with the bank's reference.
# With them, each order is posted to a licensed payment partner's endpoint,
# signed with HMAC SHA-256 of the body in x-clause-signature, and the partner
# reports back to https://api.clause.insure/api/payouts/callback signed the
# same way.
#
#   CLAUSE_OFFRAMP_URL=
#   CLAUSE_OFFRAMP_SECRET=

# Rider buying cover under a person's signed permission. Two values, and both
# are needed; with either missing Rider only prepares proposals.
#
# 1. Make a long random purchase key and keep it out of this file:
#      openssl rand -hex 32
#    Put ONLY its SHA-256 here:
#      echo -n "<the key>" | sha256sum
#   CLAUSE_RIDER_PURCHASE_KEY_SHA256=
#
# 2. Create a second latch whose upstream is https://api.clause.insure, whose
#    endpoint filter allows only POST /api/rider/purchase, with a daily rate
#    limit you choose, and which injects the purchase key as the header
#    x-clause-rider-key. Its token goes here:
#   CLAUSE_RIDER_BUY_LATCH=lat_...

# The demonstration writes policies by the thousand and, once settled, they
# were kept for ever: everything that walks the book pays for them. Only the
# most recent settled demonstration policies are kept; the rest are forgotten
# with their settlements, and the chain keeps their arithmetic so every figure
# it publishes stays the same. Nothing a person bought is ever touched. Set to
# 0 to keep everything, which is what a deployment with no demonstration wants.
#   CLAUSE_DEMO_KEEP=2000

# Address search and "use my location" go through this server to OpenStreetMap
# (Photon for search, Nominatim for naming a point), cached and spaced to one
# request a second each. Nominatim asks heavy users to identify themselves;
# an address here is sent with each request if set.
#   CLAUSE_GEOCODER_EMAIL=

# Buying cover on a home or a vehicle outright at POST /api/policies, without
# the issuing company's review of the address, the ownership and the accepted
# contract. Off unless set: the site always applies, and a deployment should
# not offer a way round the review.
#   CLAUSE_DIRECT_BUY=1

# Set by the service unit, not here: CLAUSE_STATE_DIR (/var/lib/clause, where
# the book and uploaded documents live) and the port (8080, in ExecStart).
# Rider's own calls back into this service assume that port.

# Where money comes in from outside. Shown to a person who wants to add
# balance: a bank account to transfer to (IBAN and the account name) and, if
# you hold them, wallet addresses that receive USDC. Each transfer becomes a
# funding request the operator confirms on the operator page once the money
# has arrived; nothing is credited automatically.
#   CLAUSE_FUNDING_IBAN=
#   CLAUSE_FUNDING_NAME=
#   CLAUSE_FUNDING_BANK=
#   CLAUSE_FUNDING_RIALO=
#   CLAUSE_FUNDING_SOLANA=
#   CLAUSE_FUNDING_EVM=
#
# Each wallet address must say which chain it is watched on, and the service
# refuses to offer one that does not. The same twenty bytes exist on Ethereum,
# on Base, on every other EVM chain and on all of their test networks, and a
# transfer sent on the wrong one cannot be brought back; the name is printed
# above the address so nobody has to guess. Write it the way a wallet's
# network picker writes it.
#   CLAUSE_FUNDING_RIALO_CHAIN=
#   CLAUSE_FUNDING_SOLANA_CHAIN=
#   CLAUSE_FUNDING_EVM_CHAIN=
#
# Set this when the addresses above are on test networks. The page then says
# so, in the words a person needs: send test tokens only, and the balance it
# credits is not money. It is declared rather than read off the chain's name,
# because that would make the chains we recognise safe and the ones we do not
# dangerous, which is the wrong way round.
#   CLAUSE_FUNDING_TESTNET=1

# Automatic confirmation of wallet deposits. With an RPC endpoint the service
# reads the USDC transfers into the receiving address every half minute and
# credits a waiting request itself: on Solana by the reference written in the
# transfer's memo (or the sending address), on an Ethereum style chain by the
# sending address, since a token transfer carries no memo. Bank transfers are
# always confirmed by a person. Public endpoints work; a provider's endpoint
# (Helius, Alchemy, Infura and the like) is more reliable.
#   CLAUSE_FUNDING_SOLANA_RPC=https://api.mainnet-beta.solana.com
#   CLAUSE_FUNDING_SOLANA_USDC=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
#   CLAUSE_FUNDING_EVM_RPC=https://ethereum-rpc.publicnode.com
#   CLAUSE_FUNDING_EVM_USDC=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
#
# On test networks instead. Base Sepolia is the chain the anchor already
# writes to, so a deployment that wants one chain to watch should use it. The
# token addresses are Circle's own, from
# developers.circle.com/stablecoins/usdc-contract-addresses, and test USDC for
# either chain comes from faucet.circle.com.
#
#   CLAUSE_FUNDING_TESTNET=1
#   CLAUSE_FUNDING_EVM=<an address you control on Base Sepolia>
#   CLAUSE_FUNDING_EVM_CHAIN=Base Sepolia
#   CLAUSE_FUNDING_EVM_RPC=https://sepolia.base.org
#   CLAUSE_FUNDING_EVM_USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e
#
#   CLAUSE_FUNDING_SOLANA=<an address you control on Solana devnet>
#   CLAUSE_FUNDING_SOLANA_CHAIN=Solana devnet
#   CLAUSE_FUNDING_SOLANA_RPC=https://api.devnet.solana.com
#   CLAUSE_FUNDING_SOLANA_USDC=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# The public chain beside the protocol's own (Base Sepolia). With nothing set
# the service records what it would send and the proof page still works.
# Deploy the contracts once with scripts/deploy_anchor.py, which prints
# these lines; then set them and restart. See docs/anchor.md.
#CLAUSE_ANCHOR_CHAIN_ID=84532
#CLAUSE_ANCHOR_RPC=https://sepolia.base.org
#CLAUSE_ANCHOR_POLICY=0x...
#CLAUSE_ANCHOR_BOOK=0x...
#CLAUSE_ANCHOR_KEY=0x...
#CLAUSE_ANCHOR_EVERY=600
